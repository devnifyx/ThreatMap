# Dependencies (a symlink here, so no trailing slash — that would not match it)
node_modules

# Build output
dist/
build/
.validation/dist/

# A stale copy of another project's app, kept only as reference material.
# Nothing in the build imports it.
.validation/full-app/

# Caches
.validation/vite-cache/
.vite/
*.tsbuildinfo

# Generated by .validation/build-tests.cjs from core-tests.ts
.validation/core-tests.mjs

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Claude Code local settings
.claude/settings.local.json

# Editor and OS
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
