{
  "name": "threat-map",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Global threat map — 3D globe and flat world map renderers.",
  "scripts": {
    "dev": "vite --config .validation/vite.config.mts",
    "build": "vite build --config .validation/vite.config.mts",
    "preview": "vite preview --config .validation/vite.config.mts",
    "typecheck": "tsc --noEmit -p .validation/frontend/tsconfig.json",
    "prepare-geography": "node .validation/prepare-geography.cjs",
    "build-tests": "node .validation/build-tests.cjs",
    "check-data": "node .validation/check-data.cjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "lucide-react": "1.42.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.184.0"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.1",
    "@types/geojson": "7946.0.16",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "topojson-client": "3.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
